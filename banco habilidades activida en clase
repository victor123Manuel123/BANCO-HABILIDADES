##creacion de cuentas html 

<!DOCTYPE html>
<html>
<head>
    
    <title>Crear Cuenta - Banco de Habilidades</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    
    <p><a href="index.html">← Volver al inicio</a></p>

    <h2>Crear una Cuenta Nueva</h2>
    <p>Súmate a nuestra red de crecimiento</p>

    
    <form>
        
        <h3>1. Datos Personales</h3>
        <p>
            Nombre completo:
            <input type="text" required>
        </p>

        <p>
            Numero de telefono:
            <input type="tel" minlength="10" maxlength="10" required>
        </p>

        <p>
            Correo electronico:
            <input type="email" required>
        </p>

        
        <h3>2. Tu Perfil Profesional</h3>
        <p>
        ¿Cuál es tu categoría principal?
            <select id="categoria" name="categoria" required>
                <option value="">-- Selecciona una opción --</option>
                <option value="textil">Confección y Textil</option>
                <option value="educacion">Tutorías y Educación</option>
                <option value="tecnologia">Tecnología y Diseño</option>
                <option value="hogar">Servicios para el Hogar</option>
                <option value="otro">Otra habilidad</option>
            </select>
        </p>

        <p>
            
            Describe brevemente lo que sabes hacer:
        <input type="text">
        </p>

    
        <h3>3. Seguridad</h3>
        <p>
            Crea una contraseña:
            <input type="password" minlength="8" placeholder="Minimo 8 caracteres" required>
        </p>

        <!-- Aceptación de términos cooperativos -->
        <p>
            <input type="checkbox" id="terminos" required>
            Acepta terminos y condiciones
        </p>

        
        <p>
            <input type="submit" value="Registrarme y Crear Perfil">
        </p>
    </form>

    <hr>

    <p>
        ¿Ya tienes una cuenta activa? <a href="registros.html">Inicia sesión aquí</a>
    </p>

</body>
</html>



