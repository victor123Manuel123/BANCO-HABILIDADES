<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Portafolio Personal - Victor</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>

  <header class="portafolio">
    <h1>Portafolio</h1>

    <section class="presentacion">
      <img src="assets/foto-perfil.jpg" alt="Foto de perfil" class="foto-perfil">
      <div class="datos-presentacion">
        <h2>Victor</h2>
        <p>Estudiante de Tecnología en Sistemas, énfasis en desarrollo de software.</p>
        <p>Experiencia en gestión administrativa y operaciones de bodega.</p>
      </div>
    </section>

    <section class="historial-academico">
      <h2>Historial Académico</h2>
      <ul id="lista-academica">
        <li>Colegio</li>
        <li>Universidad</li>
        <li>Cursos y Diplomados</li>
        <li>Taller de React</li>
      </ul>
      <button id="btn-agregar-academico" type="button">+ Agregar</button>
    </section>
  </header>

  <main class="historial-laboral">
    <h2>Historial Laboral</h2>
    <ul id="lista-laboral">
      <li>Distribuidora JMJ — de repartidor a administrador en 7 meses</li>
      <li>Distribuidora Don Bedoya</li>
    </ul>

    <div class="agregar-laboral">
      <button id="btn-agregar-laboral" type="button">+</button>
      <input type="text" id="input-nueva-experiencia" placeholder="Agregar nueva experiencia">
    </div>
  </main>

  <footer>
    <p>&copy; 2026 Victor</p>
  </footer>

  <script src="script.js"></script>
</body>
</html>
